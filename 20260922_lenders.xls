table.bbs_list td {padding:8px 5px; border-top:#e2e2e2 solid 1px; border-left:#e2e2e2 solid 1px; text-align:center;}
table.bbs_list td.first {border-left:none; }
table.bbs_list td.tit {text-align:left;}
table.bbs_list td.right {text-align:right;}
table.bbs_list .bg {background:#f7f7f7;}
